<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Math Challenge 🧮💜</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "Trebuchet MS", Arial, sans-serif;
  background: #f4efff;
  color: #4b4263;
  overflow: hidden;
}

/* =========================
   BACKGROUND MATEMATIKA
========================= */

.math-bg {
  position: fixed;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}

.symbol {
  position: absolute;
  color: rgba(112, 89, 160, 0.18);
  font-weight: bold;
  animation: float 8s infinite ease-in-out;
}

@keyframes float {
  0% {
    transform: translateY(20px) rotate(0deg);
  }

  50% {
    transform: translateY(-30px) rotate(8deg);
  }

  100% {
    transform: translateY(20px) rotate(0deg);
  }
}

/* =========================
   KOTAK UTAMA
========================= */

.container {
  position: relative;
  z-index: 2;

  width: 90%;
  max-width: 500px;

  margin: auto;
  padding: 30px 25px;

  top: 50%;
  transform: translateY(-50%);

  background: rgba(255,255,255,0.92);

  border-radius: 30px;

  box-shadow:
    0 15px 40px rgba(80,60,120,0.18);

  text-align: center;
}

/* =========================
   TEXT
========================= */

h1 {
  color: #7259a8;
  margin-bottom: 10px;
}

h2 {
  color: #6a578f;
}

.subtitle {
  font-size: 15px;
  line-height: 1.6;
}

/* =========================
   SOAL
========================= */

.question {
  font-size: 28px;
  font-weight: bold;

  margin: 25px 0;

  color: #594678;
}

input {
  width: 80%;

  padding: 13px;

  border: 2px solid #d7c8f2;

  border-radius: 15px;

  text-align: center;

  font-size: 20px;

  outline: none;
}

button {
  border: none;

  padding: 13px 25px;

  margin-top: 15px;

  border-radius: 20px;

  background: #9476c7;

  color: white;

  font-size: 16px;

  cursor: pointer;

  transition: 0.2s;
}

button:hover {
  transform: scale(1.05);
}

.message {
  min-height: 30px;

  margin-top: 15px;

  font-weight: bold;
}

/* =========================
   PROGRESS
========================= */

.progress {
  font-size: 14px;

  color: #9a88b9;

  margin-top: 20px;
}

/* =========================
   KEJUTAN
========================= */

#surprise {
  display: none;
}

.gift {
  font-size: 70px;

  animation: bounce 1.2s infinite;
}

@keyframes bounce {

  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-15px);
  }

}

.final-text {
  line-height: 1.8;
  font-size: 16px;
}
</style>
</head>

<body>

<!-- BACKGROUND SIMBOL MATEMATIKA -->

<div class="math-bg">

<span class="symbol" style="left:5%;top:10%;font-size:35px;">∑</span>
<span class="symbol" style="left:20%;top:25%;font-size:25px;">π</span>
<span class="symbol" style="left:80%;top:12%;font-size:40px;">√</span>
<span class="symbol" style="left:70%;top:35%;font-size:28px;">∞</span>
<span class="symbol" style="left:10%;top:65%;font-size:30px;">∫</span>
<span class="symbol" style="left:85%;top:70%;font-size:35px;">Δ</span>
<span class="symbol" style="left:45%;top:8%;font-size:25px;">x²</span>
<span class="symbol" style="left:55%;top:80%;font-size:30px;">θ</span>
<span class="symbol" style="left:30%;top:85%;font-size:25px;">÷</span>
<span class="symbol" style="left:92%;top:50%;font-size:25px;">×</span>
<span class="symbol" style="left:3%;top:45%;font-size:25px;">=</span>
<span class="symbol" style="left:65%;top:90%;font-size:25px;">f(x)</span>

</div>


<!-- =========================
     MATH CHALLENGE
========================= -->

<div class="container" id="game">

<h1>🧮 Math Challenge 💜</h1>

<p class="subtitle">

Sebelum kamu mendapatkan kejutan... 👀

<br>

buktikan dulu kalau kamu

<br>

<strong>anak matematika sejati 😏</strong>

</p>

<div class="question" id="question">
8 × 7 + 12 = ?
</div>

<input
type="number"
id="answer"
placeholder="Jawaban kamu..."
>

<br>

<button onclick="checkAnswer()">
SUBMIT ✨
</button>

<div class="message" id="message"></div>

<div class="progress" id="progress">
Soal 1 dari 3
</div>

</div>


<!-- =========================
     SURPRISE
========================= -->

<div class="container" id="surprise">

<div class="gift">
🎁
</div>

<h1>
YEAYYY!! 🎉
</h1>

<h2>
KAMU LULUS MATH CHALLENGE 🧮
</h2>

<p class="final-text">

Ternyata otak matematika kamu masih berfungsi dengan baik yaa 🤣💜

<br><br>

Karena kamu berhasil menjawab semuanya...

<br>

sekarang kamu berhak mendapatkan sesuatu 🎁✨

</p>

<button onclick="openGift()">
BUKA KEJUTANNYA 💜
</button>

</div>


<!-- =========================
     UCAPAN
========================= -->

<div class="container" id="birthday">

<h1>
🎉 Happy Birthday! 🎂
</h1>

<p class="final-text">

Selamat ulang tahun, sahabatkuuu 💜

<br><br>

Semoga di umur yang baru ini
kamu selalu dikelilingi hal-hal baik,
orang-orang baik,
dan tentunya rezeki yang baik juga ✨

<br><br>

Semoga semua cita-cita kamu,
termasuk yang berhubungan dengan
angka, rumus, dan segala macam
per-matematika-an itu 🤣🧮
bisa tercapai satu per satu.

<br><br>

Makasih sudah jadi sahabat
yang selalu ada.

<br><br>

Tetap jadi kamu yang sekarang yaa.
Jangan berubah jadi kalkulator 😭🤣

<br><br>

💜 HAPPY BIRTHDAY 💜

</p>

</div>


<script>

/* =========================
   SOAL MATEMATIKA
========================= */

const questions = [

{
question: "8 × 7 + 12 = ?",
answer: 68
},

{
question: "√144 + 6 × 3 = ?",
answer: 30
},

{
question: "15² − 100 = ?",
answer: 125
}

];

let currentQuestion = 0;


/* =========================
   CEK JAWABAN
========================= */

function checkAnswer() {

const userAnswer =
Number(document.getElementById("answer").value);

const message =
document.getElementById("message");

if (userAnswer === questions[currentQuestion].answer) {

message.innerHTML =
"🎉 BENARRR!! Otak matematika masih aman 😭💜";

currentQuestion++;

if (currentQuestion >= questions.length) {

setTimeout(() => {

document.getElementById("game").style.display = "none";

document.getElementById("surprise").style.display = "block";

}, 1000);

} else {

setTimeout(() => {

document.getElementById("question").innerHTML =
questions[currentQuestion].question;

document.getElementById("progress").innerHTML =
"Soal " + (currentQuestion + 1) + " dari 3";

document.getElementById("answer").value = "";

message.innerHTML = "";

}, 1000);

}

} else {

message.innerHTML =
"❌ SALAHHH 😭 Anak matematika katanya?? WKWKWK 🤣 Coba lagi!";

}

}


/* =========================
   BUKA KEJUTAN
========================= */

function openGift() {

document.getElementById("surprise").style.display = "none";

document.getElementById("birthday").style.display = "block";

}

</script>

</body>
</html>
